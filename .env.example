# Keep real values in .env. Never commit AppSecret.
WECHAT_APP_ID=
WECHAT_APP_SECRET=

# Random string shared by this service and the WeChat server configuration.
WECHAT_TOKEN=replace-with-a-random-string

# This implementation initially uses plaintext callback mode.
WECHAT_CALLBACK_MODE=plain
WECHAT_ENCODING_AES_KEY=

WECHAT_AUTHOR=三色堇絮絮念
WECHAT_CONTENT_SOURCE_URL=
PORT=3000
